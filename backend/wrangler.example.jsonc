{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afterimage-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "vars": {
    "ENVIRONMENT": "production",
    "APPLE_BUNDLE_ID": "com.2-38.afterimage",
    "APPLE_TEAM_ID": "<APPLE_TEAM_ID>",
    "APPLE_KEY_ID": "<APPLE_KEY_ID>",
    "SESSION_TTL_SECONDS": "2592000",
    "PLAYBACK_GRANT_TTL_SECONDS": "300",
    "SINGLE_UPLOAD_MAX_BYTES": "5242880",
    "MULTIPART_PART_SIZE_BYTES": "8388608",
    "QWENCLOUD_SUMMARY_BASE_URL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
    "QWENCLOUD_SUMMARY_MODEL": "qwen3.8-max-preview",
    "TRANSCRIPTION_MEDIA_BASE_URL": "https://afterimage.2-38.com",
    "SONIOX_DIRECT_UPLOAD_MAX_BYTES": "104857600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterimage-app",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "afterimage-app-media"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
