{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afterimage-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "APPLE_BUNDLE_ID": "com.2-38.afterimage",
    "SESSION_TTL_SECONDS": "2592000",
    "PLAYBACK_GRANT_TTL_SECONDS": "300",
    "SINGLE_UPLOAD_MAX_BYTES": "5242880",
    "MULTIPART_PART_SIZE_BYTES": "5242880"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afterimage-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "afterimage-test"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
