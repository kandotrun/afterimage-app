    "camera.accessibility.announcement.recording_started": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"撮影を開始しました"}},"en":{"stringUnit":{"state":"translated","value":"Recording started"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已开始录制"}},"ko":{"stringUnit":{"state":"translated","value":"촬영을 시작했습니다"}}}},
