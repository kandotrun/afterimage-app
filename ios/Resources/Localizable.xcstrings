    "notification.invite.body": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"夜10時ごろ、今日をひと言残すお誘いを届けます。通知はいつでもオフにできます。"}},"en":{"stringUnit":{"state":"translated","value":"Around 10 p.m., we'll invite you to keep one moment from the day. You can turn this off anytime."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"晚上10点左右，我们会邀请你留下今天的一个瞬间。随时可以关闭。"}},"ko":{"stringUnit":{"state":"translated","value":"밤 10시쯤, 오늘의 한 장면을 남기도록 초대해 드립니다. 언제든지 끌 수 있습니다."}}}},
