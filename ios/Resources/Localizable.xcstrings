    "timeline.load_failed_detail": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録は安全に保管されています。電波の届くところで、もう一度お試しください。"}},"en":{"stringUnit":{"state":"translated","value":"Your records are safe. Please try again once you're back online."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的记录安然无恙。请在网络恢复后再试一次。"}},"ko":{"stringUnit":{"state":"translated","value":"기록은 안전하게 보관되어 있습니다. 네트워크가 연결되면 다시 시도해 주세요."}}}},
