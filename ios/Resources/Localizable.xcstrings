    "camera.microphone.message": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"マイクへのアクセスが許可されていません。音声なしの動画として撮影できます。"}},"en":{"stringUnit":{"state":"translated","value":"Microphone access is not allowed. You can continue with a silent video."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"麦克风访问未获允许。你可以继续录制无声视频。"}},"ko":{"stringUnit":{"state":"translated","value":"마이크 접근이 허용되지 않았습니다. 소리 없는 동영상으로 계속 촬영할 수 있습니다."}}}},
    "camera.microphone.title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"音声なしで撮影しますか？"}},"en":{"stringUnit":{"state":"translated","value":"Record without audio?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"要无声录制吗？"}},"ko":{"stringUnit":{"state":"translated","value":"소리 없이 촬영할까요?"}}}},
    "camera.permission.message": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"設定からカメラへのアクセスを許可してください。"}},"en":{"stringUnit":{"state":"translated","value":"Allow camera access in Settings to record video."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请在“设置”中允许摄像头访问以录制视频。"}},"ko":{"stringUnit":{"state":"translated","value":"동영상을 촬영하려면 설정에서 카메라 접근을 허용하세요."}}}},
    "camera.permission.title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"カメラを使用できません"}},"en":{"stringUnit":{"state":"translated","value":"Camera Access Needed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要摄像头访问权限"}},"ko":{"stringUnit":{"state":"translated","value":"카메라 접근 권한 필요"}}}},
