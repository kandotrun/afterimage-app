    "memory.analysis.segments": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"タイムライン"}},"en":{"stringUnit":{"state":"translated","value":"Timeline"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时间线"}},"ko":{"stringUnit":{"state":"translated","value":"타임라인"}}}},
    "memory.analysis.completed_empty": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"映像の説明はありません。"}},"en":{"stringUnit":{"state":"translated","value":"No visual description is available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂无画面描述。"}},"ko":{"stringUnit":{"state":"translated","value":"영상 설명이 없습니다."}}}},
    "memory.analysis.seek_at": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"%@から再生"}},"en":{"stringUnit":{"state":"translated","value":"Play from %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从%@开始播放"}},"ko":{"stringUnit":{"state":"translated","value":"%@부터 재생"}}}},
    "notification.daily_post.body": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"今日はまだ何も残していません。今日のワンシーンを動画で残してみませんか？"}},"en":{"stringUnit":{"state":"translated","value":"Nothing from today yet. Capture one moment on video before the day ends."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"今天还没有留下任何记录。用视频记下今天的一个瞬间吧。"}},"ko":{"stringUnit":{"state":"translated","value":"오늘은 아직 아무것도 남기지 않았어요. 오늘의 한 장면을 동영상으로 남겨 보실래요?"}}}},
    "notification.daily_post.title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"今日の記憶を残しましょう"}},"en":{"stringUnit":{"state":"translated","value":"Save today’s memory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录今天的回忆"}},"ko":{"stringUnit":{"state":"translated","value":"오늘의 기억을 남겨 보세요"}}}},
    "playback.failed": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"再生できませんでした。"}},"en":{"stringUnit":{"state":"translated","value":"Couldn’t play this video."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法播放此视频。"}},"ko":{"stringUnit":{"state":"translated","value":"동영상을 재생할 수 없습니다."}}}},
