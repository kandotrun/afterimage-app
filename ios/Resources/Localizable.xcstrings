    "error.compression_failed": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"軽量化できませんでした。元データは送信していません。\n%@"}},"en":{"stringUnit":{"state":"translated","value":"Couldn’t optimize this media. The original file was not uploaded.\n%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法压缩此媒体，原始文件尚未上传。\n%@"}},"ko":{"stringUnit":{"state":"translated","value":"미디어를 최적화할 수 없습니다. 원본 파일은 업로드되지 않았습니다.\n%@"}}}},
    "error.generic_title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"うまくいきませんでした"}},"en":{"stringUnit":{"state":"translated","value":"Something Went Wrong"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"出现了问题"}},"ko":{"stringUnit":{"state":"translated","value":"문제가 발생했습니다"}}}},
    "error.http_status": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"通信に失敗しました（%lld）。"}},"en":{"stringUnit":{"state":"translated","value":"The request failed (%lld)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求失败（%lld）。"}},"ko":{"stringUnit":{"state":"translated","value":"요청에 실패했습니다(%lld)."}}}},
    "error.invalid_configuration": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"接続先の設定を確認できませんでした。"}},"en":{"stringUnit":{"state":"translated","value":"Couldn’t verify the server configuration."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法确认服务器配置。"}},"ko":{"stringUnit":{"state":"translated","value":"서버 설정을 확인할 수 없습니다."}}}},
    "error.invalid_response": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"サーバーから正しい応答を受け取れませんでした。"}},"en":{"stringUnit":{"state":"translated","value":"The server returned an invalid response."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器返回了无效响应。"}},"ko":{"stringUnit":{"state":"translated","value":"서버에서 올바른 응답을 받지 못했습니다."}}}},
    "error.missing_credential": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Appleの認証情報を受け取れませんでした。"}},"en":{"stringUnit":{"state":"translated","value":"Couldn’t receive your Apple sign-in credentials."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法获取 Apple 登录凭证。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 정보를 받을 수 없습니다."}}}},
    "error.capture_date_unavailable": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"写真・動画の撮影日時を取得できませんでした。撮影日時を保持した元ファイルを選んでください。"}},"en":{"stringUnit":{"state":"translated","value":"Couldn’t read the photo or video’s capture date. Choose the original file with its capture metadata."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取照片或视频的拍摄时间。请选择保留拍摄元数据的原始文件。"}},"ko":{"stringUnit":{"state":"translated","value":"사진 또는 동영상의 촬영 시간을 읽을 수 없습니다. 촬영 메타데이터가 유지된 원본 파일을 선택해 주세요."}}}},
    "error.unsupported_media": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"この写真・動画形式にはまだ対応していません。"}},"en":{"stringUnit":{"state":"translated","value":"This photo or video format isn’t supported yet."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂不支持这种照片或视频格式。"}},"ko":{"stringUnit":{"state":"translated","value":"이 사진 또는 동영상 형식은 아직 지원되지 않습니다."}}}},
    "error.upload_plan_invalid": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アップロードの準備に失敗しました。"}},"en":{"stringUnit":{"state":"translated","value":"Couldn’t prepare the upload."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备上传。"}},"ko":{"stringUnit":{"state":"translated","value":"업로드를 준비할 수 없습니다."}}}},
    "mcp.agent_setup_prompt": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"以下の認証付きAfterimage MCPをAIエージェントへ設定してください。\n\nURL: %@\nAuthorization: Bearer %@\nTransport: Streamable HTTP\n\n接続後に tools/list を実行し、list_transcriptions と get_transcription が利用できることを確認してください。tokenは秘密として扱い、ログや公開ファイルへ保存しないでください。"}},"en":{"stringUnit":{"state":"translated","value":"Configure the authenticated Afterimage MCP below in the AI agent.\n\nURL: %@\nAuthorization: Bearer %@\nTransport: Streamable HTTP\n\nAfter connecting, run tools/list and confirm that list_transcriptions and get_transcription are available. Treat the token as a secret; do not store it in logs or public files."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请在 AI 智能体中配置以下经过身份验证的 Afterimage MCP。\n\nURL: %@\nAuthorization: Bearer %@\nTransport: Streamable HTTP\n\n连接后，请运行 tools/list，并确认 list_transcriptions 和 get_transcription 可用。请将 token 视为机密，不要保存到日志或公开文件中。"}},"ko":{"stringUnit":{"state":"translated","value":"아래 인증된 Afterimage MCP를 AI 에이전트에 설정해 주세요.\n\nURL: %@\nAuthorization: Bearer %@\nTransport: Streamable HTTP\n\n연결 후 tools/list를 실행해 list_transcriptions와 get_transcription을 사용할 수 있는지 확인하세요. token은 비밀로 취급하고 로그나 공개 파일에 저장하지 마세요."}}}},
    "mcp.last_used": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"最終利用 %@"}},"en":{"stringUnit":{"state":"translated","value":"Last used %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次使用 %@"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 사용 %@"}}}},
    "mcp.never_used": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"まだ利用されていません"}},"en":{"stringUnit":{"state":"translated","value":"Not used yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未使用"}},"ko":{"stringUnit":{"state":"translated","value":"아직 사용되지 않음"}}}},
