    "memory.search.initial_title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記憶を探す"}},"en":{"stringUnit":{"state":"translated","value":"Find a Memory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找记忆"}},"ko":{"stringUnit":{"state":"translated","value":"기억 찾기"}}}},
    "memory.search.initial_detail": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"話したこと、ファイル名、映像の内容から検索できます。"}},"en":{"stringUnit":{"state":"translated","value":"Search what was said, filenames, and visual content."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可搜索说过的话、文件名和画面内容。"}},"ko":{"stringUnit":{"state":"translated","value":"말한 내용, 파일 이름, 영상 내용으로 검색할 수 있습니다."}}}},
