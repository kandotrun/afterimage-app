    "memory.analysis.unavailable_detail": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"AI共有がオフか、まだ解析対象になっていません。"}},"en":{"stringUnit":{"state":"translated","value":"AI sharing is off, or this video has not been analyzed yet."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI共享已关闭，或此视频尚未分析。"}},"ko":{"stringUnit":{"state":"translated","value":"AI 공유가 꺼져 있거나 아직 분석되지 않은 영상입니다."}}}},
    "memory.analysis.error_title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"解析結果を読み込めませんでした"}},"en":{"stringUnit":{"state":"translated","value":"Could Not Load Video Insights"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载视频分析"}},"ko":{"stringUnit":{"state":"translated","value":"영상 분석을 불러올 수 없습니다"}}}},
    "memory.analysis.retry": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"再試行"}},"en":{"stringUnit":{"state":"translated","value":"Try Again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试"}},"ko":{"stringUnit":{"state":"translated","value":"다시 시도"}}}},
