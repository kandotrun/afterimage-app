    "error.api.generic": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"通信に失敗しました。もう一度お試しください。"}},"en":{"stringUnit":{"state":"translated","value":"The request failed. Please try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求失败，请重试。"}},"ko":{"stringUnit":{"state":"translated","value":"요청에 실패했습니다. 다시 시도해 주세요."}}}},
