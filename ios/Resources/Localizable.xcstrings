    "camera.error.configuration": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"カメラを準備できませんでした"}},"en":{"stringUnit":{"state":"translated","value":"The camera could not be prepared"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备摄像头"}},"ko":{"stringUnit":{"state":"translated","value":"카메라를 준비할 수 없습니다"}}}},
    "camera.error.insufficient_storage": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"空き容量が不足しています"}},"en":{"stringUnit":{"state":"translated","value":"Not Enough Storage"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"储存空间不足"}},"ko":{"stringUnit":{"state":"translated","value":"저장 공간이 부족합니다"}}}},
    "camera.error.insufficient_storage_message": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"端末の空き容量を増やしてから再試行してください。"}},"en":{"stringUnit":{"state":"translated","value":"Free up storage on this device, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请释放设备储存空间后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"기기의 저장 공간을 확보한 후 다시 시도하세요."}}}},
    "camera.error.recording": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"動画を撮影できませんでした"}},"en":{"stringUnit":{"state":"translated","value":"The video could not be recorded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法录制视频"}},"ko":{"stringUnit":{"state":"translated","value":"동영상을 촬영할 수 없습니다"}}}},
    "camera.error.retry_message": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"もう一度カメラを準備してください。"}},"en":{"stringUnit":{"state":"translated","value":"Try preparing the camera again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请尝试重新准备摄像头。"}},"ko":{"stringUnit":{"state":"translated","value":"카메라 준비를 다시 시도하세요."}}}},
