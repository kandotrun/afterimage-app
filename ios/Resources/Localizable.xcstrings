    "auth.sign_out.detail": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"記録はサーバーに残ります。サインインし直せば、いつでも戻れます。"}},"en":{"stringUnit":{"state":"translated","value":"Your records stay on the server. Sign back in anytime to return to them."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的记录会保留在服务器上，重新登录即可随时回来。"}},"ko":{"stringUnit":{"state":"translated","value":"기록은 서버에 남아 있습니다. 다시 로그인하면 언제든 돌아올 수 있습니다."}}}},
