{
  "sourceLanguage": "ja",
  "strings": {
    "accessibility.upload_preview": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アップロード中の動画プレビュー（音声なし）"}},"en":{"stringUnit":{"state":"translated","value":"Silent preview of the video being uploaded"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在上传的视频静音预览"}},"ko":{"stringUnit":{"state":"translated","value":"업로드 중인 동영상 무음 미리보기"}}}},
    "upload.action.cancel": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アップロードをキャンセル"}},"en":{"stringUnit":{"state":"translated","value":"Cancel upload"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消上传"}},"ko":{"stringUnit":{"state":"translated","value":"업로드 취소"}}}},
    "upload.status.saving": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"あなたの残像として保存しています"}},"en":{"stringUnit":{"state":"translated","value":"Saving to your afterimage"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在保存到你的残像"}},"ko":{"stringUnit":{"state":"translated","value":"내 잔상으로 저장하는 중"}}}},
    "account.delete.action": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アカウントを削除"}},"en":{"stringUnit":{"state":"translated","value":"Delete Account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除账户"}},"ko":{"stringUnit":{"state":"translated","value":"계정 삭제"}}}},
    "account.delete.cancel": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"削除しない"}},"en":{"stringUnit":{"state":"translated","value":"Keep Account"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留账户"}},"ko":{"stringUnit":{"state":"translated","value":"계정 유지"}}}},
    "account.delete.cleanup_retry": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"端末データの消去を再試行"}},"en":{"stringUnit":{"state":"translated","value":"Retry Device Cleanup"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试清除设备数据"}},"ko":{"stringUnit":{"state":"translated","value":"기기 데이터 삭제 다시 시도"}}}},
    "account.delete.confirm": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アカウントとすべてのデータを削除しますか？"}},"en":{"stringUnit":{"state":"translated","value":"Delete your account and all data?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"要删除账户和所有数据吗？"}},"ko":{"stringUnit":{"state":"translated","value":"계정과 모든 데이터를 삭제할까요?"}}}},
    "account.delete.progress": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"安全に削除しています…"}},"en":{"stringUnit":{"state":"translated","value":"Deleting securely…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在安全删除…"}},"ko":{"stringUnit":{"state":"translated","value":"안전하게 삭제하는 중…"}}}},
    "account.delete.reauth": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Appleで再認証"}},"en":{"stringUnit":{"state":"translated","value":"Reauthenticate with Apple"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 Apple 重新认证"}},"ko":{"stringUnit":{"state":"translated","value":"Apple로 재인증"}}}},
    "account.delete.reauth_detail": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"削除を続けるには、同じApple Accountで本人確認してください。"}},"en":{"stringUnit":{"state":"translated","value":"To continue deletion, verify with the same Apple Account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"要继续删除，请使用同一个 Apple 账户验证身份。"}},"ko":{"stringUnit":{"state":"translated","value":"삭제를 계속하려면 같은 Apple 계정으로 본인 확인을 하세요."}}}},
    "account.delete.retry": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アカウント削除を再試行"}},"en":{"stringUnit":{"state":"translated","value":"Retry Account Deletion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试删除账户"}},"ko":{"stringUnit":{"state":"translated","value":"계정 삭제 다시 시도"}}}},
    "account.delete.scope": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"非公開の写真・動画、位置情報、音声、文字起こし、解析・要約、天気、MCP接続、未完了アップロードをサーバーから削除し、Keychain、通知状態、端末上の一時・待機ファイルも消去します。この操作は取り消せません。"}},"en":{"stringUnit":{"state":"translated","value":"This permanently deletes private photos and videos, location, audio, transcripts, analyses and summaries, weather, MCP connections, and pending uploads from the server. It also clears Keychain, notification state, and temporary or staged device files. This cannot be undone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从服务器永久删除私人照片和视频、位置、音频、转写、分析和摘要、天气、MCP 连接及未完成的上传，并清除钥匙串、通知状态以及设备上的临时或待上传文件。此操作无法撤销。"}},"ko":{"stringUnit":{"state":"translated","value":"비공개 사진과 동영상, 위치, 오디오, 전사, 분석 및 요약, 날씨, MCP 연결, 미완료 업로드를 서버에서 영구 삭제하고 Keychain, 알림 상태, 기기의 임시 및 대기 파일도 삭제합니다. 이 작업은 되돌릴 수 없습니다."}}}},
    "account.delete.title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アカウント削除"}},"en":{"stringUnit":{"state":"translated","value":"Account Deletion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账户删除"}},"ko":{"stringUnit":{"state":"translated","value":"계정 삭제"}}}},
    "account.settings.title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"設定"}},"en":{"stringUnit":{"state":"translated","value":"Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置"}},"ko":{"stringUnit":{"state":"translated","value":"설정"}}}},
    "action.close": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"閉じる"}},"en":{"stringUnit":{"state":"translated","value":"Close"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}},"ko":{"stringUnit":{"state":"translated","value":"닫기"}}}},
    "api.ai_consent_required": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"AIへの外部送信を利用するには、設定で明示的な同意が必要です。"}},"en":{"stringUnit":{"state":"translated","value":"Explicit consent in Settings is required before using external AI processing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用外部 AI 处理前，需要在设置中明确同意。"}},"ko":{"stringUnit":{"state":"translated","value":"외부 AI 처리를 사용하려면 설정에서 명시적으로 동의해야 합니다."}}}},
    "api.analysis_queue_limit": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"映像解析が混み合っています。時間をおいてお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"Video analysis is busy. Please try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"视频分析繁忙，请稍后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"영상 분석이 혼잡합니다. 나중에 다시 시도하세요."}}}},
    "api.apple_challenge_rate_limited": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Apple認証の準備が続いたため一時的に制限されています。少し待ってからお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"Too many Apple sign-in challenges were requested. Wait a moment and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 登录验证请求过于频繁，请稍后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 인증 요청이 너무 많습니다. 잠시 후 다시 시도하세요."}}}},
    "api.trusted_client_ip_required": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Apple認証リクエストの送信元を安全に確認できませんでした。通信環境を確認して再試行してください。"}},"en":{"stringUnit":{"state":"translated","value":"The Apple sign-in request origin could not be verified securely. Check your connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法安全验证 Apple 登录请求的来源。请检查网络连接后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 요청의 출처를 안전하게 확인할 수 없습니다. 네트워크 연결을 확인한 후 다시 시도하세요."}}}},
    "api.apple_reauthorization_required": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アカウント削除を続けるにはAppleでの再認証が必要です。"}},"en":{"stringUnit":{"state":"translated","value":"Reauthentication with Apple is required to continue account deletion."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续删除账户需要使用 Apple 重新认证。"}},"ko":{"stringUnit":{"state":"translated","value":"계정 삭제를 계속하려면 Apple 재인증이 필요합니다."}}}},
    "api.asset_creation_quota_exceeded": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"今日保存できる件数に達しました。時間をおいてお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"You reached today's asset limit. Please try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已达到今日可保存数量上限，请稍后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"오늘 저장할 수 있는 개수에 도달했습니다. 나중에 다시 시도하세요."}}}},
    "api.auth_challenge_expired": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Apple認証の有効時間が切れました。もう一度お試しください。"}},"en":{"stringUnit":{"state":"translated","value":"The Apple sign-in challenge expired. Please try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 登录验证已过期，请重试。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 인증 시간이 만료되었습니다. 다시 시도하세요."}}}},
    "api.auth_challenge_invalid": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Apple認証を確認できませんでした。もう一度お試しください。"}},"en":{"stringUnit":{"state":"translated","value":"The Apple sign-in challenge could not be verified. Please try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证 Apple 登录，请重试。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 인증을 확인할 수 없습니다. 다시 시도하세요."}}}},
    "api.auth_challenge_replayed": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"このApple認証はすでに使用されています。新しくやり直してください。"}},"en":{"stringUnit":{"state":"translated","value":"This Apple sign-in challenge was already used. Start a new attempt."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Apple 登录验证已使用，请重新开始。"}},"ko":{"stringUnit":{"state":"translated","value":"이 Apple 로그인 인증은 이미 사용되었습니다. 새로 시도하세요."}}}},
    "api.invalid_apple_challenge": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Apple認証の有効時間が切れたか、すでに使用されています。もう一度お試しください。"}},"en":{"stringUnit":{"state":"translated","value":"The Apple sign-in challenge expired, was invalid, or was already used. Please try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 登录验证已过期、无效或已使用，请重试。"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 인증이 만료되었거나 유효하지 않거나 이미 사용되었습니다. 다시 시도하세요."}}}},
    "api.daily_asset_quota_exceeded": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"今日保存できる件数に達しました。時間をおいてお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"You reached today's asset limit. Please try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已达到今日可保存数量上限，请稍后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"오늘 저장할 수 있는 개수에 도달했습니다. 나중에 다시 시도하세요."}}}},
    "api.mage_queue_busy": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"映像解析が混み合っています。時間をおいてお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"Video analysis is busy. Please try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"视频分析繁忙，请稍后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"영상 분석이 혼잡합니다. 나중에 다시 시도하세요."}}}},
    "api.rate_limited": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"操作が続いたため一時的に制限されています。少し待ってからお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"Too many requests were made. Wait a moment and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作过于频繁，请稍后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"요청이 너무 많습니다. 잠시 후 다시 시도하세요."}}}},
    "api.reauthentication_required": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"アカウント削除を続けるにはAppleでの再認証が必要です。"}},"en":{"stringUnit":{"state":"translated","value":"Reauthentication with Apple is required to continue account deletion."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续删除账户需要使用 Apple 重新认证。"}},"ko":{"stringUnit":{"state":"translated","value":"계정 삭제를 계속하려면 Apple 재인증이 필요합니다."}}}},
    "api.storage_quota_exceeded": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"保存容量の上限に達しました。不要なデータを削除してからお試しください。"}},"en":{"stringUnit":{"state":"translated","value":"Your storage limit was reached. Delete unneeded data and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已达到存储上限，请删除不需要的数据后重试。"}},"ko":{"stringUnit":{"state":"translated","value":"저장 용량 한도에 도달했습니다. 필요 없는 데이터를 삭제한 후 다시 시도하세요."}}}},
    "auth.challenge_loading": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"安全なApple認証を準備中"}},"en":{"stringUnit":{"state":"translated","value":"Preparing secure Apple sign-in"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备安全的 Apple 登录"}},"ko":{"stringUnit":{"state":"translated","value":"안전한 Apple 로그인 준비 중"}}}},
    "auth.retry": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Apple認証を準備し直す"}},"en":{"stringUnit":{"state":"translated","value":"Prepare Apple Sign-In Again"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新准备 Apple 登录"}},"ko":{"stringUnit":{"state":"translated","value":"Apple 로그인 다시 준비"}}}},
    "auth.sign_in": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Appleでサインイン"}},"en":{"stringUnit":{"state":"translated","value":"Sign in with Apple"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过 Apple 登录"}},"ko":{"stringUnit":{"state":"translated","value":"Apple로 로그인"}}}},
    "error.local_cleanup_failed": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"端末上の待機ファイルをすべて消去できませんでした。完了するまで新しい追加はできません。再試行してください。"}},"en":{"stringUnit":{"state":"translated","value":"Not all staged files could be removed from this device. New additions stay blocked until cleanup succeeds. Please retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法清除设备上的所有待处理文件。清理成功前不能添加新内容，请重试。"}},"ko":{"stringUnit":{"state":"translated","value":"기기의 대기 파일을 모두 삭제할 수 없습니다. 정리가 완료될 때까지 새 항목을 추가할 수 없습니다. 다시 시도하세요."}}}},
    "legal.privacy": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"プライバシー"}},"en":{"stringUnit":{"state":"translated","value":"Privacy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私"}},"ko":{"stringUnit":{"state":"translated","value":"개인정보"}}}},
    "legal.support": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"サポート"}},"en":{"stringUnit":{"state":"translated","value":"Support"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支持"}},"ko":{"stringUnit":{"state":"translated","value":"지원"}}}},
    "legal.terms": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"利用規約"}},"en":{"stringUnit":{"state":"translated","value":"Terms"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用条款"}},"ko":{"stringUnit":{"state":"translated","value":"이용약관"}}}},
    "privacy.ai.destination_title": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"送信先と送信データ"}},"en":{"stringUnit":{"state":"translated","value":"Destinations and data sent"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发送目的地与数据"}},"ko":{"stringUnit":{"state":"translated","value":"전송 대상과 데이터"}}}},
    "privacy.ai.existing_data": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"同意を撤回すると新しい外部処理とMCP取得を停止します。既存の文字起こし・解析・要約は非公開のまま残り、個別削除またはアカウント削除で消去できます。"}},"en":{"stringUnit":{"state":"translated","value":"Withdrawing consent stops new external processing and MCP retrieval. Existing private transcripts, analyses, and summaries remain until you delete the item or account."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"撤回同意会停止新的外部处理和 MCP 获取。已有的私人转写、分析和摘要会保留，直到你删除相关内容或账户。"}},"ko":{"stringUnit":{"state":"translated","value":"동의를 철회하면 새로운 외부 처리와 MCP 조회가 중지됩니다. 기존 비공개 전사, 분석, 요약은 항목 또는 계정을 삭제할 때까지 유지됩니다."}}}},
    "privacy.ai.grant": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"説明に同意してAI処理を有効にする"}},"en":{"stringUnit":{"state":"translated","value":"Consent and Enable AI Processing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同意说明并启用 AI 处理"}},"ko":{"stringUnit":{"state":"translated","value":"설명에 동의하고 AI 처리 활성화"}}}},
    "privacy.ai.granted": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"同意済み"}},"en":{"stringUnit":{"state":"translated","value":"Consented"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同意"}},"ko":{"stringUnit":{"state":"translated","value":"동의함"}}}},
    "privacy.ai.introduction": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"撮影・圧縮・非公開タイムライン・再生・削除は同意なしで使えます。以下の外部AI処理とエージェント共有だけが明示的な同意後に始まります。"}},"en":{"stringUnit":{"state":"translated","value":"Capture, compression, private timeline, playback, and deletion work without consent. Only the external AI processing and agent sharing below begin after explicit opt-in."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无需同意即可拍摄、压缩、使用私人时间线、播放和删除。只有以下外部 AI 处理和智能体共享会在明确选择同意后开始。"}},"ko":{"stringUnit":{"state":"translated","value":"촬영, 압축, 비공개 타임라인, 재생, 삭제는 동의 없이 사용할 수 있습니다. 아래 외부 AI 처리와 에이전트 공유만 명시적 동의 후 시작됩니다."}}}},
    "privacy.ai.mcp": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"MCP client / AIエージェント：あなたが個別に許可した動画・文字起こし・解析を取得"}},"en":{"stringUnit":{"state":"translated","value":"MCP clients / AI agents: retrieve videos, transcripts, and analyses you explicitly allow"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MCP 客户端 / AI 智能体：获取你逐项明确允许的视频、转写和分析"}},"ko":{"stringUnit":{"state":"translated","value":"MCP 클라이언트 / AI 에이전트: 사용자가 개별 허용한 동영상, 전사, 분석 조회"}}}},
    "privacy.ai.not_granted": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"オフ"}},"en":{"stringUnit":{"state":"translated","value":"Off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭"}},"ko":{"stringUnit":{"state":"translated","value":"꺼짐"}}}},
    "privacy.ai.purpose": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"目的：記憶の文字起こし、映像解析、検索、日次要約と、あなたが許可したAIからの読み取りを提供するため。広告や追跡には使いません。"}},"en":{"stringUnit":{"state":"translated","value":"Purpose: transcription, video analysis, search, daily summaries, and read access from AI you authorize. The data is not used for advertising or tracking."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目的：提供记忆转写、视频分析、搜索、每日摘要以及你授权的 AI 读取。数据不会用于广告或跟踪。"}},"ko":{"stringUnit":{"state":"translated","value":"목적: 기억 전사, 영상 분석, 검색, 일일 요약 및 사용자가 허용한 AI의 읽기 접근 제공. 광고나 추적에는 사용하지 않습니다."}}}},
    "privacy.ai.qwen": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Alibaba Cloud Qwen：文字起こし、必要な映像区間・フレームを送信し、映像解析・検索・日次要約を生成"}},"en":{"stringUnit":{"state":"translated","value":"Alibaba Cloud Qwen: receives transcripts and needed video segments or frames for video analysis, search, and daily summaries"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"阿里云通义千问：接收转写及所需视频片段或帧，用于视频分析、搜索和每日摘要"}},"ko":{"stringUnit":{"state":"translated","value":"Alibaba Cloud Qwen: 전사와 필요한 영상 구간 또는 프레임을 받아 영상 분석, 검색, 일일 요약 생성"}}}},
    "privacy.ai.soniox": {"localizations":{"ja":{"stringUnit":{"state":"translated","value":"Soniox：動画の音声を送信し、文字起こしを生成"}},"en":{"stringUnit":{"state":"translated","value":"Soniox: receives video audio to create transcripts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Soniox：接收视频音频并生成转写"}},"ko":{"stringUnit":{"state":"translated","value":"Soniox: 동영상 오디오를 받아 전사 생성"}}}},
