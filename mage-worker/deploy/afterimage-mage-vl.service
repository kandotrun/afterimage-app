[Unit]
Description=Afterimage Mage-VL pull worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/afterimage-mage-vl
EnvironmentFile=%h/.config/afterimage-mage-vl/worker.env
ExecStart=/usr/bin/docker compose up --no-build --remove-orphans
ExecStop=/usr/bin/docker compose down --timeout 120
SuccessExitStatus=130
Restart=on-failure
RestartSec=10
TimeoutStopSec=180

[Install]
WantedBy=default.target
